# ============================================
# ClassMonitor AI — .gitignore
# ============================================

# ---- Python / Django ----
*.py[cod]
*$py.class
__pycache__/
*.so

# ---- Virtual Environments ----
venv/
env/
.venv/
demo/

# ---- Environment & Secrets ----
.env
*.env
.env.*

# ---- Database ----
db.sqlite3
db.sqlite3-journal

# ---- Media uploads ----
media/

# ---- Static files (collected) ----
staticfiles/
static_root/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ---- OS Files ----
Thumbs.db
.DS_Store

# ---- Distribution / Build ----
dist/
build/
*.egg-info/
*.egg

# ---- Logs ----
*.log

# ---- Byte-compiled ----
*.pyc

# ---- Coverage ----
htmlcov/
.coverage
.coverage.*
